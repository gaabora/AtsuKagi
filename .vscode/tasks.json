{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "group": {
        "kind": "build"
      },
      "command": "${config:haribol.paths.ahkCompiler}",
      "type": "shell",
      "args": [
        "/in",
        "${workspaceRoot}\\Haribol!.ahk",
        "/icon",
        "${workspaceRoot}\\assets\\app.ico",
        "/base",
        "${config:haribol.paths.ahkRuntime}"
      ],
      "problemMatcher": {
        "owner": "ahk",
        "fileLocation": [
          "absolute"
        ],
        "pattern": [
          {
            "regexp": "^(.*\\.ahk) \\((\\d+)\\) : ==> (.*)$",
            "file": 1,
            "line": 2,
            "message": 3
          },
          {
            "regexp": "^\\s*Specifically: (.*)$",
            "message": 1
          }
        ]
      }
    },
    {
      "label": "test",
      "type": "shell",
      "command": "${config:haribol.paths.ahkRuntime}",
      "args": [
        "tests\\RunAllTests.ahk"
      ],
      "group": {
        "kind": "test"
      },
      "problemMatcher": {
        "owner": "ahk",
        "fileLocation": [
          "absolute"
        ],
        "pattern": [
          {
            "regexp": "^(.*\\.ahk) \\((\\d+)\\) : ==> (.*)$",
            "file": 1,
            "line": 2,
            "message": 3
          },
          {
            "regexp": "^\\s*Specifically: (.*)$",
            "message": 1
          }
        ]
      }
    },
    {
      "label": "test cli",
      "type": "shell",
      "command": "${config:haribol.paths.ahkRuntime}",
      "args": [
        "tests\\RunAllTests.ahk"
      ],
      "group": {
        "kind": "build"
      },
      "problemMatcher": []
    },
    {
      "label": "test gui",
      "type": "shell",
      "command": "${config:haribol.paths.ahkRuntime}",
      "args": [
        "tests\\RunAllTestsGui.ahk"
      ],
      "group": {
        "kind": "build"
      },
      "problemMatcher": []
    },
    {
      "label": "run script",
      "group": {
        "kind": "build"
      },
      "type": "shell",
      "command": "${config:haribol.paths.ahkRuntime}",
      "args": [
        "${workspaceRoot}\\Haribol!.ahk"
      ],
      "problemMatcher": {
        "owner": "ahk",
        "fileLocation": [
          "absolute"
        ],
        "pattern": [
          {
            "regexp": "^(.*\\.ahk) \\((\\d+)\\) : ==> (.*)$",
            "file": 1,
            "line": 2,
            "message": 3
          },
          {
            "regexp": "^\\s*Specifically: (.*)$",
            "message": 1
          }
        ]
      }
    },
    {
      "label": "run binary",
      "group": {
        "kind": "build"
      },
      "command": "${workspaceRoot}\\Haribol!.exe",
      "type": "shell",
      "problemMatcher": []
    }
  ]
}
