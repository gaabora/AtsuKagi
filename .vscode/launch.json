{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "runtime": "${config:haribol.paths.ahkRuntime}",
      "type": "ahkdbg",
      "request": "launch",
      "name": "AHK v2 Debug APP",
      "program": "${workspaceFolder}/Haribol!.ahk",
      "port": 9005,
      "captureStreams": true,
      "stopOnEntry": false,
    },
    {
      "runtime": "${config:haribol.paths.ahkRuntime}",
      "type": "ahkdbg",
      "request": "launch",
      "name": "AHK v2 Debug current file",
      "program": "${file}",
      "port": 9005,
      "captureStreams": true,
      "stopOnEntry": false,
      "skipFiles": [
        "${workspaceFolder}/tests/**/*.ahk"
      ]
    },
    {
      "runtime": "${config:haribol.paths.ahkRuntime}",
      "type": "ahkdbg",
      "request": "launch",
      "name": "AHK v2 Debug IniFileTests",
      "program": "${workspaceFolder}/tests/IniFileTests.ahk",
      "port": 9005,
      "captureStreams": true,
      "stopOnEntry": false,
    }
  ]
}